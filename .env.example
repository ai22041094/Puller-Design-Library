# Copy to .env, or run bash setup.sh to generate it interactively.
DOMAIN=app.example.com
APP_ORIGIN=https://app.example.com
POSTGRES_DB=puller_library
POSTGRES_USER=puller
# Use at least 32 URL-safe characters, e.g. openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
# Optional: former bucket/private prefix, only to detect legacy media references
# during rejected-import cleanup. No old storage credentials are used.
LEGACY_PRIVATE_OBJECT_DIR=
