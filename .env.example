# Copy this file to .env and replace every placeholder before deployment.
# Generate a URL-safe database password with: openssl rand -hex 32
POSTGRES_DB=puller_library
POSTGRES_USER=puller
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# Public port for the Nginx frontend container.
WEB_PORT=8080

# OIDC provider configuration. The application currently uses the client ID
# in REPL_ID and requires an OIDC provider that supports PKCE.
ISSUER_URL=https://identity.example.com/oidc
REPL_ID=replace-with-your-oidc-client-id
